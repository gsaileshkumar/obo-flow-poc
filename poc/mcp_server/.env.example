# poc-mcp configuration
# Copy to .env and fill in with values from your Entra app registrations.
# See ../PREREQUISITES.md for how to obtain each value.

ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Application (client) ID + secret of the "poc-mcp" app registration.
# Inbound tokens (from the agent) must have aud == api://<this id>.
MCP_APP_CLIENT_ID=00000000-0000-0000-0000-000000000000
MCP_APP_CLIENT_SECRET=replace-with-client-secret-value
# MCP_APP_ID_URI=api://00000000-0000-0000-0000-000000000000
MCP_REQUIRED_SCOPE=access_as_user

# poc-backend's identity - used both to know the OBO target scope and to
# reach the backend over HTTP.
BACKEND_APP_CLIENT_ID=00000000-0000-0000-0000-000000000000
# BACKEND_APP_ID_URI=api://00000000-0000-0000-0000-000000000000
BACKEND_REQUIRED_SCOPE=access_as_user
BACKEND_BASE_URL=http://127.0.0.1:8000

# Optional overrides, normally derived from ENTRA_TENANT_ID automatically.
# ENTRA_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# ENTRA_JWKS_URI=https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys

MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_BASE_URL=http://127.0.0.1:8001
