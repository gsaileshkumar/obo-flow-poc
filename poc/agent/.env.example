# poc-agent configuration
# Copy to .env and fill in with values from your Entra app registrations.
# See ../PREREQUISITES.md for how to obtain each value.

ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Application (client) ID + secret of the "poc-agent" app registration.
AGENT_APP_CLIENT_ID=00000000-0000-0000-0000-000000000000
AGENT_APP_CLIENT_SECRET=replace-with-client-secret-value

# Must exactly match a "Web" platform redirect URI registered on poc-agent.
AGENT_REDIRECT_URI=http://localhost:8501/auth/callback

# poc-mcp's identity - the scope poc-agent requests on login.
MCP_APP_CLIENT_ID=00000000-0000-0000-0000-000000000000
# MCP_APP_ID_URI=api://00000000-0000-0000-0000-000000000000
MCP_REQUIRED_SCOPE=access_as_user

# Where the MCP server's streamable-HTTP endpoint is reachable.
MCP_SERVER_URL=http://127.0.0.1:8001/mcp

AGENT_HOST=127.0.0.1
AGENT_PORT=8501

# Used to sign/identify session cookies. Use a long random value outside
# of local-only POC use - e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
AGENT_SESSION_SECRET=dev-only-insecure-secret-change-me

# Gemini model for the ADK agent's LLM calls (independent of the Entra
# chain). Requires GOOGLE_API_KEY to be set, or Vertex AI ADC configured.
ADK_MODEL=gemini-2.0-flash
# GOOGLE_API_KEY=your-gemini-api-key
